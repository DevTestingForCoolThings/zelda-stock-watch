{
  "_comment": "Targets to watch. Set enabled:false to mute one without deleting it.",

  "ntfy_server": "https://ntfy.sh",

  "_heartbeat": "Send a quiet all-clear push this often (hours), so silence is trustworthy. 6 keeps you blind for at most 6h if the bot dies; raise to 12 or 24 if it feels noisy, or 0 to disable.",
  "heartbeat_hours": 6,

  "politeness": {
    "_comment": "Minimum seconds between two requests to the same site, and how long to leave a site alone after it rate-limits us (HTTP 429) if it does not say how long.",
    "request_spacing_seconds": 3,
    "default_cooldown_minutes": 30
  },

  "self_test": {
    "_comment": "Nintendo items that are normally in stock. 'Run workflow' with self_test ticked checks these with the real Nintendo checker and sends a real push through the real alert path, proving detection works end to end. The heartbeat also re-checks them every time. Only one needs to be in stock for the test to pass.",
    "urls": [
      "https://www.nintendo.com/en-ca/store/products/nintendo-switch-2-pro-controller-123674/",
      "https://www.nintendo.com/en-ca/store/products/joy-con-2-blue-light-yellow-127071/",
      "https://www.nintendo.com/en-ca/store/products/dual-usb-playstand-for-nintendo-switch-2-126527/",
      "https://www.nintendo.com/en-ca/store/products/amiibo-sidon-the-legend-of-zelda-series-120817/"
    ]
  },

  "discovery": {
    "enabled": true,
    "_comment": "Alerts when a NEW matching product page appears on the Nintendo store in 'region'. Other regions' sitemaps are scanned too, because the CA sitemap lags: products listed only abroad are probed on the CA store directly. Newly discovered products are then stock-watched automatically if auto_watch is true.",
    "region": "en-ca",
    "sitemaps": [
      "https://www.nintendo.com/en-ca/store/sitemap.xml",
      "https://www.nintendo.com/us/store/sitemap.xml"
    ],
    "auto_watch": true,
    "every_minutes": 60,
    "must_match_any": [
      "zelda",
      "hyrule",
      "triforce",
      "ocarina"
    ],
    "and_must_match_any": [
      "40th",
      "anniversary",
      "pro-controller",
      "carrying-case",
      "amiibo",
      "collector",
      "special-edition",
      "pin-set",
      "art-book",
      "artbook",
      "soundtrack",
      "121642",
      "switch-2"
    ],
    "ignore_containing": [
      "-upgrade-pack-",
      "digital-download"
    ]
  },

