{
  "_comment": "Targets to watch. Set enabled:false to mute one without deleting it.",

  "ntfy_server": "https://ntfy.sh",

  "discovery": {
    "enabled": true,
    "sitemap": "https://www.nintendo.com/en-ca/store/sitemap.xml",
    "_comment": "Alerts when a NEW product URL appears on the Nintendo CA store matching these patterns. This is how we catch Nintendo-CA-exclusive collectibles whose URLs don't exist yet.",
    "must_match_any": [
      "zelda",
      "hyrule",
      "triforce",
      "ocarina"
    ],
    "and_must_match_any": [
      "40th",
      "anniversary",
      "pro-controller",
      "carrying-case",
      "amiibo",
      "collector",
      "special-edition",
      "pin-set",
      "art-book",
      "artbook",
      "soundtrack",
      "121642",
      "switch-2"
    ],
    "ignore_containing": [
      "-upgrade-pack-",
      "digital-download"
    ]
  },

  "targets": [
    {
      "id": "nintendo-ca-console",
      "enabled": true,
      "source": "nintendo",
      "label": "Switch 2 Zelda 40th Console (Nintendo CA)",
